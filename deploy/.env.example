# Copy to deploy/.env and adjust as needed. Every HELIOS_* variable below is
# documented with the default internal/config/config.go applies when the
# variable is unset (or set to an empty string).

# --- docker-compose postgres service ---------------------------------------
POSTGRES_USER=helios
POSTGRES_PASSWORD=helios
POSTGRES_DB=helios_ats

# --- HTTP --------------------------------------------------------------
HELIOS_HTTP_ADDR=:7462
# Long: uploads are large audio files, not small JSON bodies.
HELIOS_HTTP_READ_TIMEOUT=5m
HELIOS_HTTP_WRITE_TIMEOUT=60s
HELIOS_HTTP_IDLE_TIMEOUT=120s
HELIOS_HTTP_SHUTDOWN_TIMEOUT=20s
# 2 GiB, in bytes.
HELIOS_HTTP_MAX_UPLOAD_BYTES=2147483648

# --- Database ------------------------------------------------------------
# Never logged; internal/config redacts it before it ever reaches a log line.
HELIOS_DATABASE_DSN=postgres://helios:helios@postgres:5432/helios_ats?sslmode=disable
HELIOS_DATABASE_CONNECT_TIMEOUT=10s
HELIOS_DATABASE_MAX_CONNS=10
HELIOS_DATABASE_AUTO_MIGRATE=true

# --- Storage -------------------------------------------------------------
HELIOS_STORAGE_ROOT_DIR=/data
# 1 GiB, in bytes. Uploads are refused once free space on this volume drops
# below it.
HELIOS_STORAGE_MIN_FREE_BYTES=1073741824

# --- Transcriber -----------------------------------------------------------
# "whispercpp" (real transcription via the whisper-cli subprocess) or "fake"
# (deterministic, no subprocess -- for tests and local dev).
HELIOS_TRANSCRIBER_KIND=whispercpp
# Resolved via PATH.
HELIOS_TRANSCRIBER_BINARY=whisper-cli
# Holds ggml-<model>.bin weight files.
HELIOS_TRANSCRIBER_MODEL_DIR=/models
# Used when a submission's Options.Model is empty. Must be one of the
# comma-separated models below.
HELIOS_TRANSCRIBER_DEFAULT_MODEL=base
HELIOS_TRANSCRIBER_ALLOWED_MODELS=tiny,base,small,medium,large-v3
HELIOS_TRANSCRIBER_THREADS=4
# Together with HELIOS_AUDIO_TIMEOUT below, must be strictly less than
# HELIOS_WORKER_JOB_TIMEOUT, or a slow job races its own job deadline.
HELIOS_TRANSCRIBER_TIMEOUT=30m

# --- Audio -----------------------------------------------------------------
# ffprobe/ffmpeg binaries, resolved via PATH.
HELIOS_AUDIO_FFMPEG_BINARY=ffmpeg
HELIOS_AUDIO_FFPROBE_BINARY=ffprobe
# Audio longer than this is rejected before normalization.
HELIOS_AUDIO_MAX_DURATION=4h
# Combined probe+normalize budget for a single job.
HELIOS_AUDIO_TIMEOUT=10m

# --- Worker --------------------------------------------------------------
HELIOS_WORKER_CONCURRENCY=2
HELIOS_WORKER_POLL_INTERVAL=2s
HELIOS_WORKER_LEASE_DURATION=1m
# Must be < HELIOS_WORKER_LEASE_DURATION, or a lease can expire between
# heartbeats even under normal operation.
HELIOS_WORKER_HEARTBEAT_INTERVAL=15s
HELIOS_WORKER_JOB_TIMEOUT=45m
HELIOS_WORKER_MAX_ATTEMPTS=3
HELIOS_WORKER_BACKOFF_BASE=10s
HELIOS_WORKER_BACKOFF_MAX=10m

# --- Retention -------------------------------------------------------------
HELIOS_RETENTION_ENABLED=true
# How old a terminal (succeeded/failed/canceled) job must be before the
# retention sweep deletes it -- both its database row and its files under
# HELIOS_STORAGE_ROOT_DIR. 168h = 7 days. See docs/RUNBOOK.md.
HELIOS_RETENTION_MAX_AGE=168h
# How often the retention sweep runs. Only meaningful while
# HELIOS_RETENTION_ENABLED is true.
HELIOS_RETENTION_INTERVAL=1h

# --- Observability ---------------------------------------------------------
# "debug", "info", "warn" or "error".
HELIOS_OBSERVABILITY_LOG_LEVEL=info
# "json" or "text".
HELIOS_OBSERVABILITY_LOG_FORMAT=json
HELIOS_OBSERVABILITY_METRICS_ENABLED=true
# Off by default: no OTLP collector is required to run Helios. If you
# enable tracing, HELIOS_OBSERVABILITY_OTLP_ENDPOINT below becomes required.
HELIOS_OBSERVABILITY_TRACING_ENABLED=false
HELIOS_OBSERVABILITY_OTLP_ENDPOINT=
HELIOS_OBSERVABILITY_SERVICE_NAME=helios-ats
