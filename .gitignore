# Go build output
/bin/
/dist/
*.exe
*.test
*.out

# Local env / data
.env
deploy/.env
/data

# Whisper model weights. These are hundreds of MB to several GB and are
# fetched by `make models`, not tracked here.
/models/
*.bin

# Desktop app: Node / frontend build output
desktop/frontend/dist/
desktop/frontend/node_modules/
# Wails writes this md5 of package.json to decide whether to re-run
# npm install. Build cache, not source.
desktop/frontend/package.json.md5

# Desktop app: Wails build output (binaries, platform scaffolding wails
# init/build generate locally -- mirrors the sibling ingestion service's
# desktop/.gitignore, which keeps this out of version control entirely)
desktop/build/

# Editor / OS cruft
.idea/
.vscode/
*.swp
.DS_Store

# Browser verification artifacts
.playwright-cli/
desktop/frontend/test-results/
desktop/frontend/playwright-report/
